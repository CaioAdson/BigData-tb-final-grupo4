ELASTIC_VERSION=8.15.3
ES_JAVA_OPTS=-Xms1g -Xmx1g

REDIS_PASSWORD=troque-esta-senha

KAFKA_TOPIC_QUESTOES=enade.questoes
KAFKA_PARTITIONS_QUESTOES=6
KAFKA_TOPIC_DLQ=enade.questoes.dlq
KAFKA_PARTITIONS_DLQ=3

# Pipeline de ingestao (semana 2)
KAFKA_GROUP_ID=enade-indexador
ES_INDEX=enade-questoes
ES_SHARDS=3
ES_REPLICAS=0

# API (semana 3/4)
CACHE_TTL=300
SESSAO_TTL=3600
CARRINHO_MAX=100

# LDAP (usuarios e perfis). Troque TODAS as senhas no seu .env.
LDAP_ADMIN_PASSWORD=troque-admin-ldap
LDAP_BIND_PASSWORD=troque-leitura-ldap
LDAP_SENHA_PROFESSOR_DEMO=troque-senha-professor
LDAP_SENHA_ESTUDANTE_DEMO=troque-senha-estudante

# Kerberos (somente com docker-compose.kerberos.yml)
KRB5_MASTER_PASSWORD=troque-master-kdc
ELASTIC_PASSWORD=troque-senha-elastic
